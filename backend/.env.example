# Copy to .env and adjust for your machine.
ENVIRONMENT=development
DEBUG=false

# PostgreSQL connection string used by the API and by Alembic.
DATABASE_URL=postgresql+psycopg://flowforge:flowforge@localhost:5432/flowforge

# Database used by the test suite. It is dropped and recreated between runs.
TEST_DATABASE_URL=postgresql+psycopg://flowforge:flowforge@localhost:5432/flowforge_test

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000

# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
COOKIE_SECURE=false

# Outbound HTTP policy for the HTTP Request node.
# Leave the default unless the deployment genuinely needs internal access.
HTTP_ALLOW_PRIVATE_NETWORKS=false
# Comma separated hosts exempted from the private-address check.
HTTP_ALLOWED_HOSTS=
